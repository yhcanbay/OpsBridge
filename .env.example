# Bu dosyayı .env olarak kopyalayıp parolaları ve şifreleme anahtarını belirleyin.
POSTGRES_DB=opsbridge
POSTGRES_USER=opsbridge
POSTGRES_PASSWORD=replace-with-a-local-database-password
OPSBRIDGE_ADMIN_USERNAME=admin
OPSBRIDGE_ADMIN_PASSWORD=replace-with-a-local-admin-password
# GitHub tokenları panelden eklenir. Anahtar üretimi ve yedekleme: README.md.
OPSBRIDGE_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
