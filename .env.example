# Bu dosyayı .env olarak kopyalayıp parolaları ve şifreleme anahtarını belirleyin.
POSTGRES_DB=opsbridge
POSTGRES_USER=opsbridge
POSTGRES_PASSWORD=replace-with-a-local-database-password
OPSBRIDGE_ADMIN_USERNAME=admin
OPSBRIDGE_ADMIN_PASSWORD=replace-with-a-local-admin-password
# GitHub tokenları panelden eklenir. Anahtar üretimi ve yedekleme: README.md.
OPSBRIDGE_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# URL ve job yolu proje profilinden düzenlenir. local-jenkins referansı bu URL'yi kullanır.
JENKINS_BASE_URL=http://host.docker.internal:8081
JENKINS_USERNAME=
JENKINS_API_TOKEN=
# Ortak token gönderilebilecek ek Jenkins URL'leri, virgülle ayrılır.
JENKINS_ALLOWED_BASE_URLS=
# Boşsa yerel Docker istemcisinin varsayılan bağlantısı kullanılır.
OPSBRIDGE_DOCKER_HOST=
